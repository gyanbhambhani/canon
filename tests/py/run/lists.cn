@effects(io)
def main() -> None:
    xs = range(1, 6)
    print(to_string(xs))
    print(to_string(append(xs, 6)))
    print(to_string(reverse(xs)))
    print(to_string(take(xs, 2)))
    print(to_string(drop(xs, 3)))
    print(to_string(first(xs)))
    print(to_string(last(drop(xs, 9))))
    print(to_string(3 in xs))
    print(to_string(zip(xs, ["a", "b"])))
    print(to_string(enumerate(["x", "y"])))
    print(to_string(fold(xs, 0, lambda acc, x: acc + x)))
    print(to_string(sum(xs)))
    print(to_string(len(filter(xs, lambda x: x % 2 == 1))))
    print(to_string(xs))
