type Shape = Circle(radius: float) | Rect(width: float, height: float) | Dot

def area(s: Shape) -> float:
    match s:
        case Circle(r):
            return 3.0 * r * r
        case Rect(w, h):
            return w * h
        case Dot:
            return 0.0

def name(s: Shape) -> str:
    match s:
        case Circle(_):
            return "circle"
        case Rect(_, _):
            return "rect"
        case Dot:
            return "dot"

@effects(io)
def main() -> None:
    for s in [Circle(1.0), Rect(2.0, 3.5), Dot]:
        print(name(s) + " " + to_string(area(s)))
    print(to_string(Rect(2.0, 3.5)))
    print(to_string([Dot, Circle(0.5)]))
