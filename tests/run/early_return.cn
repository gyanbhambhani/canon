fn first_even(xs: List[Int]) -> Option[Int] {
  for x in xs {
    if x % 2 == 0 {
      return Some(x)
    }
  }
  return None
}

fn main() -> Unit
  effects: io
{
  [1, 3, 4, 5, 6]
    |> first_even()
    |> to_string()
    |> print()
  [1, 3]
    |> first_even()
    |> to_string()
    |> print()
}
