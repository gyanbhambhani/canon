fn main() -> Unit
  effects: io
{
  print(to_string(7 / 2))
  print(to_string(-7 / 2))
  print(to_string(-7 % 3))
  print(to_string(7.0 / 2.0))
  print(to_string(1.0 + 2.0))
  print(to_string(2 * 3 + 4))
  print(to_string(0.1 + 0.2))
  print(to_string(pow(2, 10)))
  print(to_string(abs(-5)))
  print(to_string(min(3, 9)))
  print(to_string(max(3, 9)))
}
