fn echo_all() -> Int
  effects: io
{
  var count = 0
  var line = read_line()
  for line != None {
    set count = count + 1
    print(concat("> ", unwrap_or(line, "")))
    set line = read_line()
  }
  return count
}

fn main() -> Unit
  effects: io
{
  let n = echo_all()
  n
    |> to_string()
    |> concat(" lines")
    |> print()
}
