type PasswordChange {
  old_password: String,
  new_password: String,
  confirm: String,
}

type PasswordChanged {
  changed: Bool,
}

api fn change_password(r: PasswordChange) -> PasswordChanged
  route: POST "/password"
  requires: str_len(r.old_password) >= 1
    && str_len(r.new_password) >= 8
    && r.confirm == r.new_password
    && r.new_password != r.old_password
{
  return PasswordChanged { changed: true }
}
