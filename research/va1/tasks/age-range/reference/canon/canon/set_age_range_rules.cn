type AgeRange {
  min_age: Int,
  max_age: Int,
  title: String,
}

api fn set_age_range(r: AgeRange) -> AgeRange
  route: POST "/events/ages"
  requires: r.min_age >= 0
    && r.min_age <= 120
    && r.max_age >= 0
    && r.max_age <= 120
    && r.min_age <= r.max_age
    && str_len(trim(r.title)) > 0
    && str_len(r.title) <= 60
{
  return r
}
