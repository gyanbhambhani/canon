{
  "id": "booking",
  "set": 2,
  "title": "Book a stay",
  "adapted": null,
  "route": { "method": "POST", "path": "/bookings" },
  "feature": { "module": "bookStay", "fn": "bookStay" },
  "base": { "guest": "=alnum(int(1, 40))", "start": "=int(0, 300)", "end": "=$start + int(1, 30)" },
  "random": { "guest": "=pick(['', ' ', 'Ada', rep('a', int(35, 45))])", "start": "=int(-5, 370)", "end": "=int(-5, 420)" },
  "rules": [
    { "id": "guest_not_blank", "kind": "single", "desc": "guest is not blank",
      "inside": [{ "set": { "guest": " a " } }],
      "outside": [{ "set": { "guest": "" } }, { "set": { "guest": " " } }, { "set": { "guest": "\t \n" } }] },
    { "id": "guest_length", "kind": "single", "desc": "guest has at most 40 characters",
      "inside": [{ "set": { "guest": "=rep('a', 40)" } }],
      "outside": [{ "set": { "guest": "=rep('a', 41)" } }] },
    { "id": "start_range", "kind": "single", "desc": "start is 0 to 365",
      "inside": [{ "set": { "start": 0, "end": 1 } }, { "set": { "start": 365, "end": 366 } }],
      "outside": [{ "set": { "start": -1, "end": 0 } }, { "set": { "start": 366, "end": 367 } }] },
    { "id": "end_after_start", "kind": "cross", "desc": "end is after start",
      "inside": [{ "set": { "end": "=$start + 1" } }],
      "outside": [{ "set": { "end": "=$start" } }, { "set": { "end": "=$start - 1" } }] },
    { "id": "stay_max", "kind": "cross", "desc": "the stay is at most 30 nights",
      "inside": [{ "set": { "end": "=$start + 30" } }],
      "outside": [{ "set": { "end": "=$start + 31" } }] }
  ]
}
