type StayRequest {
  guest: String,
  start: Int,
  end: Int,
}

type Stay {
  guest: String,
  start: Int,
  end: Int,
  nights: Int,
}

api fn book_stay(r: StayRequest) -> Stay
  route: POST "/bookings"
  requires: str_len(trim(r.guest)) > 0
    && str_len(r.guest) <= 40
    && r.start >= 0
    && r.start <= 365
    && r.end > r.start
    && r.end - r.start <= 30
{
  return Stay { guest: r.guest, start: r.start, end: r.end, nights: r.end - r.start }
}
