   ]
  ],
  "ret": "Result[Int, String]",
  "desc": "Apply the operations to the starting balance in order. A withdrawal larger than the current balance stops processing and returns the error \"insufficient funds at step N\", where N is the 1-based position of that operation. Otherwise return the final balance.",
  "tests": [
   [
    [
     10,
     [
      {
       "kind": "Deposit",
       "amount": 5
      },
      {
       "kind": "Withdraw",
       "amount": 3
      }
     ]
    ],
    {
     "ok": true,
     "value": 12
    }
   ],
   [
    [
     0,
     [
      {
       "kind": "Withdraw",
       "amount": 1
      }
     ]
    ],
    {
     "ok": false,
     "error": "insufficient funds at step 1"
    }
   ],
   [
    [
     5,
     [
      {
       "kind": "Withdraw",
       "amount": 5
      },
      {
       "kind": "Deposit",
       "amount": 1
      },
      {
       "kind": "Withdraw",
       "amount": 2
      },
      {
       "kind": "Withdraw",
       "amount": 5
      }
     ]
    ],
    {
     "ok": false,
     "error": "insufficient funds at step 3"
    }
   ],
   [
    [
     7,
     []
    ],
    {
     "ok": true,
     "value": 7
    }
   ]
  ],
  "decls": {
   "canon": "type Op =\n  | Deposit(amount: Int)\n  | Withdraw(amount: Int)",
   "ts": "type Op = { kind: \"Deposit\"; amount: number } | { kind: \"Withdraw\"; amount: number };\ntype Result<T> = { ok: true; value: T } | { ok: false; error: string };"
  },
  "typeKinds": {
   "Op": "sum"
  }
 },
 {
  "id": "rpn",
  "tier": "hard",
  "fn": "rpn",
  "params": [
   [
    "tokens",
    "List[String]"
   ]
  ],
  "ret": "Result[Int, String]",
  "desc": "Evaluate the tokens as a reverse Polish notation expression over integers. A token is an integer (an optional leading minus sign, then digits) or one of + - * /, where / divides and truncates toward zero. Process tokens left to right. Errors, as exact strings: \"stack underflow\" when an operator has fewer than two values to use, \"division by zero\", \"bad token: \" followed by the token for anything else, and \"expected one value\" if the stack does not hold exactly one value at the end.",
  "tests": [
   [
    [
     [
      "3",
      "4",
      "+",
      "2",
      "*"
     ]
    ],
    {
     "ok": true,
     "value": 14
    }
   ],
   [
    [
     [
      "1",
      "+"
     ]
    ],
    {
     "ok": false,
     "error": "stack underflow"
    }
   ],
   [
    [
     [
      "4",
      "0",
      "/"
     ]
    ],
    {
     "ok": false,
     "error": "division by zero"
    }
   ],
   [
    [
     [
      "2",
      "x"
     ]
    ],
    {
     "ok": false,
     "error": "bad token: x"
    }
   ],
   [
    [
     [
      "1",
      "2"
     ]
    ],
    {
     "ok": false,
     "error": "expected one value"
    }
   ],
   [
    [
     [
      "7",
      "-2",
      "/"
     ]
    ],
    {
     "ok": true,
     "value": -3
    }
   ],
   [
    [
     []
    ],
    {
     "ok": false,
     "error": "expected one value"
    }
   ]
  ],
  "decls": {
   "canon": "",
   "ts": "type Result<T> = { ok: true; value: T } | { ok: false; error: string };"
  },
  "typeKinds": {}
 },
