def rpn(tokens: list[str]) -> Result[int, str]:
    stack = []
    for token in tokens:
        if token in ("+", "-", "*", "/"):
            if len(stack) < 2:
                return Err("stack underflow")
            b = stack.pop()
            a = stack.pop()
            if token == "+":
                stack.append(a + b)
            elif token == "-":
                stack.append(a - b)
            elif token == "*":
                stack.append(a * b)
            else:
                if b == 0:
                    return Err("division by zero")
                stack.append(int(a / b))
        else:
            value = parse_int(token)
            if value is None:
                return Err("bad token: " + token)
            stack.append(value)
    if len(stack) != 1:
        return Err("expected one value")
    return Ok(stack[0])
