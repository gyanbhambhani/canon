def fizzbuzz_word(i: int) -> str:
    if i % 15 == 0:
        return "FizzBuzz"
    if i % 3 == 0:
        return "Fizz"
    if i % 5 == 0:
        return "Buzz"
    return str(i)


@requires(n >= 0)
@ensures(len(result) == n)
def fizzbuzz_list(n: int) -> list[str]:
    return [fizzbuzz_word(i) for i in range(1, n + 1)]
