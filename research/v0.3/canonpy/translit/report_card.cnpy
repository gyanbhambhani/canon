@dataclass
class Student:
    name: str
    scores: list[int]


def average(scores: list[int]) -> int:
    n = len(scores)
    if n == 0:
        return 0
    return sum(scores) // n


def grade(avg: int) -> str:
    if avg >= 90:
        return "A"
    if avg >= 80:
        return "B"
    if avg >= 70:
        return "C"
    if avg >= 60:
        return "D"
    return "F"


def report_card(students: list[Student]) -> list[tuple[str, str]]:
    return [(s.name, grade(average(s.scores))) for s in students]
