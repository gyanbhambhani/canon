def run_lengths(s: str) -> list[tuple[str, int]]:
    runs = []
    cur = ""
    count = 0
    for c in s:
        if count > 0 and c == cur:
            count += 1
        else:
            if count > 0:
                runs.append((cur, count))
            cur = c
            count = 1
    if count > 0:
        runs.append((cur, count))
    return runs
