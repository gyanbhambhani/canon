{
 "id": "sliding_window_max",
 "cases": [
  {
   "args": [
    [
     1,
     3,
     -1,
     -3,
     5,
     3,
     6,
     7
    ],
    3
   ],
   "expected": {
    "ok": true,
    "value": [
     3,
     3,
     5,
     5,
     6,
     7
    ]
   }
  },
  {
   "args": [
    [
     4
    ],
    1
   ],
   "expected": {
    "ok": true,
    "value": [
     4
    ]
   }
  },
  {
   "args": [
    [],
    1
   ],
   "expected": {
    "ok": false,
    "error": "window larger than input"
   }
  },
  {
   "args": [
    [
     1,
     2
    ],
    0
   ],
   "expected": {
    "ok": false,
    "error": "window must be positive"
   }
  },
  {
   "args": [
    [],
    0
   ],
   "expected": {
    "ok": false,
    "error": "window must be positive"
   }
  },
  {
   "args": [
    [
     1,
     2
    ],
    3
   ],
   "expected": {
    "ok": false,
    "error": "window larger than input"
   }
  },
  {
   "args": [
    [
     2,
     2,
     2
    ],
    2
   ],
   "expected": {
    "ok": true,
    "value": [
     2,
     2
    ]
   }
  },
  {
   "args": [
    [
     5,
     4,
     3,
     2
    ],
    4
   ],
   "expected": {
    "ok": true,
    "value": [
     5
    ]
   }
  },
  {
   "args": [
    [
     -5,
     -2,
     -9
    ],
    1
   ],
   "expected": {
    "ok": true,
    "value": [
     -5,
     -2,
     -9
    ]
   }
  }
 ]
}
