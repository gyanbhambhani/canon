  },
  {
   "args": [
    "\\*a",
    "*a"
   ],
   "expected": true
  },
  {
   "args": [
    "\\*a",
    "xa"
   ],
   "expected": false
  },
  {
   "args": [
    "ab\\",
    "ab\\"
   ],
   "expected": true
  },
  {
   "args": [
    "*.txt",
    "notes.txt.bak"
   ],
   "expected": false
