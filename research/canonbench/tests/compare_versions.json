{
 "id": "compare_versions",
 "cases": [
  {
   "args": [
    "1.2.3",
    "1.2.10"
   ],
   "expected": {
    "ok": true,
    "value": -1
   }
  },
  {
   "args": [
    "1.0",
    "1"
   ],
   "expected": {
    "ok": true,
    "value": 0
   }
  },
  {
   "args": [
    "2",
    "1.9.9.9"
   ],
   "expected": {
    "ok": true,
    "value": 1
   }
  },
  {
   "args": [
    "1.01",
    "1.1"
   ],
   "expected": {
    "ok": true,
    "value": 0
   }
  },
  {
   "args": [
    "1.2.3.4.5",
    "1"
   ],
   "expected": {
    "ok": false,
    "error": "bad version: 1.2.3.4.5"
   }
  },
  {
   "args": [
    "1.2",
    "1..2"
   ],
   "expected": {
    "ok": false,
    "error": "bad version: 1..2"
   }
  },
  {
   "args": [
    "",
    "1"
   ],
   "expected": {
    "ok": false,
    "error": "bad version: "
   }
  },
  {
   "args": [
    "x",
    "y"
   ],
   "expected": {
    "ok": false,
    "error": "bad version: x"
   }
  },
  {
   "args": [
    "0.0.0.1",
    "0"
   ],
   "expected": {
    "ok": true,
    "value": 1
   }
  },
  {
   "args": [
    "10.0",
    "9.99"
   ],
   "expected": {
    "ok": true,
    "value": 1
   }
  }
 ]
}
