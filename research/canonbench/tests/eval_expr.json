{
 "id": "eval_expr",
 "cases": [
  {
   "args": [
    "2+3*4"
   ],
   "expected": {
    "ok": true,
    "value": 14
   }
  },
  {
   "args": [
    " ( 2+3 ) * 4 "
   ],
   "expected": {
    "ok": true,
    "value": 20
   }
  },
  {
   "args": [
    "20-3-2*2"
   ],
   "expected": {
    "ok": true,
    "value": 13
   }
  },
  {
   "args": [
    "(1-10)/4"
   ],
   "expected": {
    "ok": true,
    "value": -2
   }
  },
  {
   "args": [
    ""
   ],
   "expected": {
    "ok": false,
    "error": "unexpected end"
   }
  },
  {
   "args": [
    "2*(3+4"
   ],
   "expected": {
    "ok": false,
    "error": "unexpected end"
   }
  },
  {
   "args": [
    "2+*3"
   ],
   "expected": {
    "ok": false,
    "error": "unexpected character: *"
   }
  },
  {
   "args": [
    "4/(2-2)"
   ],
   "expected": {
    "ok": false,
    "error": "division by zero"
   }
  },
  {
   "args": [
    "4/0+)"
   ],
   "expected": {
    "ok": false,
    "error": "unexpected character: )"
   }
  },
  {
   "args": [
    "(1)2"
   ],
   "expected": {
    "ok": false,
    "error": "unexpected character: 2"
   }
  }
 ]
}
