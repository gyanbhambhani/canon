    { "fn": "get_setting", "args": ["/etc/app/missing.conf", "mode", "slow"] },
    { "fn": "needs_reload", "args": [1699999990000, 60000] },
    { "fn": "reload_if_stale", "args": ["/etc/app/app.conf", "region", 1600000000000, 60000] },
