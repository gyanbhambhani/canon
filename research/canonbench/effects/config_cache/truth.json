{
  "functions": {
    "parse_line": [],
    "parse_config": [],
    "fetch_from_cache": [],
    "cache_is_fresh": [],
    "read_config": ["fs"],
    "get_setting": ["fs"],
    "needs_reload": ["time"],
    "reload_if_stale": ["fs", "time"]
  },
  "drive": [
    { "fn": "parse_line", "args": ["a = b"] },
