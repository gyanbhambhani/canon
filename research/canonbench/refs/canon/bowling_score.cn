fn at(xs: List[Int], i: Int) -> Int {
  return xs
    |> drop(i)
    |> first()
    |> unwrap_or(0)
}

fn bowling_score(rolls: List[Int]) -> Result[Int, String] {
  if len(filter(rolls, |r| r < 0 || r > 10)) > 0 {
    return Err("invalid roll")
  }
  let n = len(rolls)
  var i = 0
  var score = 0
  for frame in range(1, 10) {
    if i >= n {
      return Err("incomplete game")
    }
    if at(rolls, i) == 10 {
      score = score + 10 + at(rolls, i + 1) + at(rolls, i + 2)
      i = i + 1
    } else {
      if i + 1 >= n {
        return Err("incomplete game")
      }
      let pins = at(rolls, i) + at(rolls, i + 1)
      if pins > 10 {
        return Err("too many pins in frame " + to_string(frame))
      }
      if pins == 10 {
        score = score + 10 + at(rolls, i + 2)
      } else {
        score = score + pins
      }
      i = i + 2
    }
  }
  if i + 1 >= n {
    return Err("incomplete game")
  }
  let a = at(rolls, i)
  let b = at(rolls, i + 1)
  var tenth = 2
  if a == 10 {
    if i + 2 >= n {
      return Err("incomplete game")
    }
    if b != 10 && b + at(rolls, i + 2) > 10 {
      return Err("too many pins in frame 10")
    }
    tenth = 3
  } else {
    if a + b > 10 {
      return Err("too many pins in frame 10")
    }
    if a + b == 10 {
      if i + 2 >= n {
        return Err("incomplete game")
      }
      tenth = 3
    }
  }
  if i + tenth < n {
    return Err("too many rolls")
  }
  return Ok(score + sum(drop(rolls, i)))
}
