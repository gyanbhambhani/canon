type Expense {
  payer: String,
  amount_cents: Int,
}

fn paid(expenses: List[Expense], who: String) -> Int {
  return expenses
    |> filter(|e| e.payer == who)
    |> map(|e| e.amount_cents)
    |> sum()
}

fn extra_cent(i: Int, extra: Int) -> Int {
  if i < extra {
    return 1
  }
  return 0
}

fn adjust(b: (String, Int), from: String, to: String, amount: Int) -> (String, Int) {
  if b.0 == from {
    return (b.0, b.1 + amount)
  }
  if b.0 == to {
    return (b.0, b.1 - amount)
  }
  return b
}

fn settle_debts(expenses: List[Expense], people: List[String]) -> List[(String, String, Int)] {
  let n = len(people)
  let total = sum(map(expenses, |e| e.amount_cents))
  let share = total / n
  let extra = total % n
  var bal = map(enumerate(people), |p| (p.1, paid(expenses, p.1) - share - extra_cent(p.0, extra)))
  var out = []
  var going = true
  while going {
    let debtors = sort_by(filter(bal, |b| b.1 < 0), |b| b.1)
    let creditors = sort_desc_by(filter(bal, |b| b.1 > 0), |b| b.1)
    if len(debtors) == 0 || len(creditors) == 0 {
      going = false
    } else {
      let d = unwrap_or(first(debtors), ("", 0))
      let c = unwrap_or(first(creditors), ("", 0))
      let amount = min(-d.1, c.1)
      out = append(out, (d.0, c.0, amount))
      bal = map(bal, |b| adjust(b, d.0, c.0, amount))
    }
  }
  return out
}
