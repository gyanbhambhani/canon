fn runs(s: String) -> List[(String, Int)] {
  var out = []
  var cur = ""
  var n = 0
  for c in split(s, "") {
    if n > 0 && c == cur {
      n = n + 1
    } else {
      if n > 0 {
        out = append(out, (cur, n))
      }
      cur = c
      n = 1
    }
  }
  if n > 0 {
    out = append(out, (cur, n))
  }
  return out
}

fn piece(c: String, n: Int) -> String {
  if n == 1 {
    return c
  }
  return c + to_string(n)
}

fn rle_compress(s: String) -> String {
  let enc = s
    |> runs()
    |> map(|c, n| piece(c, n))
    |> join("")
  if str_len(enc) < str_len(s) {
    return enc
  }
  return s
}
