fn lis_length(xs: List[Int]) -> (Int, Int) {
  if len(xs) == 0 {
    return (0, 0)
  }
  var lens = []
  var cnts = []
  for x in xs {
    var l = 1
    var c = 1
    for t in zip(xs, zip(lens, cnts)) {
      let y = t.0
      let lc = t.1
      if y < x {
        if lc.0 + 1 > l {
          l = lc.0 + 1
          c = lc.1
        } else if lc.0 + 1 == l {
          c = c + lc.1
        }
      }
    }
    lens = append(lens, l)
    cnts = append(cnts, c)
  }
  let best = fold(lens, 0, |a, b| max(a, b))
  let total = lens
    |> zip(cnts)
    |> filter(|p| p.0 == best)
    |> map(|p| p.1)
    |> sum()
  return (best, total)
}
