fn wrap_text(s: String, width: Int) -> List[String] {
  let words = filter(split(s, " "), |w| w != "")
  var lines = []
  var cur = ""
  for w in words {
    if cur == "" {
      cur = w
    } else if str_len(cur) + 1 + str_len(w) <= width {
      cur = cur + " " + w
    } else {
      lines = append(lines, cur)
      cur = w
    }
  }
  if cur != "" {
    lines = append(lines, cur)
  }
  return lines
}
