fn max_subarray(xs: List[Int]) -> Option[(Int, Int, Int)] {
  if len(xs) == 0 {
    return None
  }
  var best = (unwrap_or(first(xs), 0), 0, 0)
  for p in enumerate(xs) {
    var s = 0
    for q in enumerate(drop(xs, p.0)) {
      s = s + q.1
      let shorter = q.0 < best.2 - best.1
      if s > best.0 || s == best.0 && shorter {
        best = (s, p.0, p.0 + q.0)
      }
    }
  }
  return Some(best)
}
