{
  "name": "canon-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx --conditions=source src/run.ts",
    "report": "tsx --conditions=source src/report.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@canon/compiler": "workspace:*",
    "@canon/runtime": "workspace:*",
    "openai": "^7.62.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
