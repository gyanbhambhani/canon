table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin
  | NoSuchUser(email: String)

type NewEmail {
  new_email: String,
}

api fn signup(input: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}

api fn change_email(email: String, input: NewEmail) -> Result[Profile, UserError]
  route: PATCH "/users/{email}/email"
  effects: store(users)
  requires: is_email(input.new_email)
{
  return match get(users, email) {
    Some(u) => move_user(u, input.new_email),
    None => Err(NoSuchUser(email)),
  }
}

# The users table is keyed by email: the row moves to its new key.
fn move_user(u: User, new_email: String) -> Result[Profile, UserError]
  effects: store(users)
{
  if is_some(get(users, new_email)) {
    return Err(Taken(new_email))
  }
  var moved = u
  moved.email = new_email
  delete(users, u.email)
  insert(users, moved)
  return Ok(profile(moved))
}
