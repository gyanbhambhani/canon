table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
  age: Int,
}

type Signup {
  email: String,
  name: String,
  password: String,
  age: Int,
}

type Login {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
  age: Int,
}

type UserError =
  | Taken(email: String)
  | BadLogin

api fn signup(s: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(s.email) && str_len(trim(s.name)) > 0 && str_len(s.password) > 7 && s.age >= 13
{
  if is_some(get(users, s.email)) {
    return Err(Taken(s.email))
  }
  let user = User {
    email: s.email,
    name: trim(s.name),
    password_hash: hash_password(s.password),
    id: uuid(),
    age: s.age,
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name, age: u.age }
}

api fn login(input: Login) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}
