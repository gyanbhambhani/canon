use errors.{ShopError}

table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
  active: Bool,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

api fn signup(input: Signup) -> Result[Profile, ShopError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
    active: true,
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, ShopError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match (verify_password(input.password, u.password_hash), u.active) {
      (false, _) => Err(BadLogin),
      (true, false) => Err(Deactivated(u.email)),
      (true, true) => Ok(profile(u)),
    },
    None => Err(BadLogin),
  }
}

api fn deactivate(email: String) -> Result[Profile, ShopError]
  route: POST "/users/{email}/deactivate"
  effects: store(users)
{
  return match get(users, email) {
    Some(u) => Ok(profile(save(users, deactivated(u)))),
    None => Err(NoSuchUser(email)),
  }
}

fn deactivated(u: User) -> User {
  var out = u
  out.active = false
  return out
}
