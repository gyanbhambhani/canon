table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

type PasswordChange {
  old_password: String,
  new_password: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin
  | NoSuchUser(email: String)
  | WrongPassword

api fn signup(input: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}

api fn change_password(email: String, input: PasswordChange) -> Result[Profile, UserError]
  route: POST "/users/{email}/password"
  effects: rand, store(users)
  requires: str_len(input.new_password) >= 8 && input.new_password != input.old_password
{
  return match get(users, email) {
    Some(u) => match verify_password(input.old_password, u.password_hash) {
      true => Ok(profile(save(users, with_password(u, input.new_password)))),
      false => Err(WrongPassword),
    },
    None => Err(NoSuchUser(email)),
  }
}

fn with_password(u: User, password: String) -> User
  effects: rand
{
  var out = u
  out.password_hash = hash_password(password)
  return out
}
