table users: User key email

type Address {
  street: String,
  city: String,
  postcode: String,
}

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
  address: Option[Address],
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin
  | NoSuchUser(email: String)

api fn signup(input: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
    address: None,
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}

api fn set_default_address(email: String, a: Address) -> Result[Address, UserError]
  route: PUT "/users/{email}/default-address"
  effects: store(users)
  requires: str_len(trim(a.street)) > 0 && str_len(trim(a.city)) > 0 && str_len(a.postcode) >= 3
{
  let address = Address { street: trim(a.street), city: trim(a.city), postcode: a.postcode }
  return match get(users, email) {
    Some(u) => Ok(with_address(u, address)),
    None => Err(NoSuchUser(email)),
  }
}

fn with_address(u: User, a: Address) -> Address
  effects: store(users)
{
  var out = u
  out.address = Some(a)
  save(users, out)
  return a
}

api fn get_default_address(email: String) -> Result[Option[Address], UserError]
  route: GET "/users/{email}/default-address"
  effects: store(users)
{
  return match get(users, email) {
    Some(u) => Ok(u.address),
    None => Err(NoSuchUser(email)),
  }
}
