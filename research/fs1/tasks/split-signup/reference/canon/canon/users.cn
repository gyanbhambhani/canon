table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
  confirmed: Bool,
  token: String,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

# A new account waiting for confirmation, and the token that confirms it.
type Pending {
  email: String,
  token: String,
}

type Confirmation {
  token: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin
  | NotConfirmed
  | BadToken

api fn signup(input: Signup) -> Result[Pending, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
    confirmed: false,
    token: uuid(),
  }
  insert(users, user)
  return Ok(Pending { email: user.email, token: user.token })
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn confirm(input: Confirmation) -> Result[Profile, UserError]
  route: POST "/users/confirm"
  effects: store(users)
{
  let pending = filter(scan(users), |u| !u.confirmed && u.token == input.token)
  return match first(pending) {
    Some(u) => Ok(profile(save(users, confirmed(u)))),
    None => Err(BadToken),
  }
}

fn confirmed(u: User) -> User {
  var out = u
  out.confirmed = true
  out.token = ""
  return out
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match (verify_password(input.password, u.password_hash), u.confirmed) {
      (false, _) => Err(BadLogin),
      (true, false) => Err(NotConfirmed),
      (true, true) => Ok(profile(u)),
    },
    None => Err(BadLogin),
  }
}
