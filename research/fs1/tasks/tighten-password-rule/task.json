{
  "id": "tighten-password-rule",
  "kind": "change",
  "title": "Signup passwords need at least 12 characters and a digit",
  "features": [
    {
      "module": "frontend/src/features/signup.ts",
      "signature": "signup(baseUrl: string, email: string, name: string, password: string): Promise<Outcome<Profile>>"
    }
  ],
  "supersedes": [
    "test_signup_and_login",
    "test_reports",
    "signup-probe"
  ],
  "validation": [
    {
      "feature": "signup",
      "args": [
        {
          "name": "email",
          "gen": "email"
        },
        {
          "name": "name",
          "gen": "name"
        },
        {
          "name": "password",
          "gen": "password"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/users",
        "body": {
          "email": "$email",
          "name": "$name",
          "password": "$password"
        }
      }
    }
  ],
  "adapted": {
    "for": "canon",
    "reason": "a 12+ character password with no digit is a typed 400 (WeakPassword), not a 422: Canon's portable requires cannot inspect characters"
  }
}
