table users: User key email

table resets: Reset key token

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

# An unredeemed reset token and the account it belongs to.
type Reset {
  token: String,
  email: String,
}

type ResetToken {
  token: String,
}

type PasswordReset {
  token: String,
  new_password: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin
  | NoSuchUser(email: String)
  | BadToken

api fn signup(input: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}

api fn request_reset(email: String) -> Result[ResetToken, UserError]
  route: POST "/users/{email}/reset"
  effects: rand, store(resets), store(users)
{
  if !is_some(get(users, email)) {
    return Err(NoSuchUser(email))
  }
  let reset = Reset { token: uuid(), email: email }
  insert(resets, reset)
  return Ok(ResetToken { token: reset.token })
}

api fn reset_password(input: PasswordReset) -> Result[Profile, UserError]
  route: POST "/password-resets"
  effects: rand, store(resets), store(users)
  requires: str_len(input.new_password) >= 8
{
  return match get(resets, input.token) {
    Some(r) => redeem(r, input.new_password),
    None => Err(BadToken),
  }
}

# A token works once: it is deleted as it is redeemed.
fn redeem(r: Reset, password: String) -> Result[Profile, UserError]
  effects: rand, store(resets), store(users)
{
  delete(resets, r.token)
  return match get(users, r.email) {
    Some(u) => Ok(profile(save(users, with_password(u, hash_password(password))))),
    None => Err(BadToken),
  }
}

fn with_password(u: User, password_hash: String) -> User {
  var out = u
  out.password_hash = password_hash
  return out
}
