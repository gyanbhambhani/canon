{
  "id": "rename-name-to-full-name",
  "kind": "change",
  "title": "Rename a user's name field to full_name",
  "features": [
    {
      "module": "frontend/src/features/signup.ts",
      "signature": "signup(baseUrl: string, email: string, fullName: string, password: string): Promise<Outcome<Profile>>, where Profile now has full_name"
    }
  ],
  "supersedes": ["test_signup_and_login", "test_signup_validation", "test_reports", "signup-probe"],
  "validation": [
    {
      "feature": "signup",
      "args": [{ "name": "email", "gen": "email" }, { "name": "fullName", "gen": "name" }, { "name": "password", "gen": "password" }],
      "request": { "method": "POST", "path": "/users", "body": { "email": "$email", "full_name": "$fullName", "password": "$password" } }
    }
  ]
}
