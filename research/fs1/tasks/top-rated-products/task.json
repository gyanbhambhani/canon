{
  "id": "top-rated-products",
  "kind": "feature",
  "title": "Star ratings and the top-rated products",
  "features": [
    { "module": "frontend/src/features/rateProduct.ts", "signature": "rateProduct(baseUrl: string, sku: string, stars: number): Promise<Outcome<RatingSummary>>" },
    { "module": "frontend/src/features/topRatedProducts.ts", "signature": "topRatedProducts(baseUrl: string, limit: number): Promise<Outcome<TopRated[]>>" }
  ],
  "validation": [
    {
      "feature": "rateProduct",
      "args": [{ "name": "sku", "gen": "sku" }, { "name": "stars", "gen": "small" }],
      "request": { "method": "POST", "path": "/products/$sku/ratings", "body": { "stars": "$stars" } }
    },
    {
      "feature": "topRatedProducts",
      "args": [{ "name": "limit", "gen": "int" }],
      "request": { "method": "GET", "path": "/top-rated", "query": { "limit": "$limit" } }
    }
  ]
}
