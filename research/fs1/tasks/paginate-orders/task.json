{
  "id": "paginate-orders",
  "kind": "feature",
  "title": "A paginated list of a customer's orders",
  "features": [{ "module": "frontend/src/features/listOrders.ts", "signature": "listOrders(baseUrl: string, email: string, page: number, perPage: number): Promise<Outcome<Order[]>>" }],
  "validation": [
    {
      "feature": "listOrders",
      "args": [{ "name": "email", "gen": "email" }, { "name": "page", "gen": "small" }, { "name": "perPage", "gen": "small" }],
      "request": { "method": "GET", "path": "/orders", "query": { "email": "$email", "page": "$page", "per_page": "$perPage" } }
    }
  ]
}
