{
  "id": "list-users",
  "kind": "feature",
  "title": "A paginated list of users, sorted by email",
  "features": [{ "module": "frontend/src/features/listUsers.ts", "signature": "listUsers(baseUrl: string, page: number, perPage: number): Promise<Outcome<Profile[]>>" }],
  "validation": [
    {
      "feature": "listUsers",
      "args": [{ "name": "page", "gen": "small" }, { "name": "perPage", "gen": "small" }],
      "request": { "method": "GET", "path": "/users", "query": { "page": "$page", "per_page": "$perPage" } }
    }
  ]
}
