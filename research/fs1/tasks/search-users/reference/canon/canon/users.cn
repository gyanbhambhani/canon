table users: User key email

type User {
  email: String,
  name: String,
  password_hash: String,
  id: String,
}

type Signup {
  email: String,
  name: String,
  password: String,
}

type Profile {
  email: String,
  name: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin

api fn signup(input: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(input.email) && str_len(trim(input.name)) > 0 && str_len(input.password) >= 8
{
  if is_some(get(users, input.email)) {
    return Err(Taken(input.email))
  }
  let user = User {
    email: input.email,
    name: trim(input.name),
    password_hash: hash_password(input.password),
    id: uuid(),
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, name: u.name }
}

api fn login(input: Signup) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}

api fn search_users(q: String) -> List[Profile]
  route: GET "/users/search"
  effects: store(users)
  requires: str_len(trim(q)) >= 2
{
  let needle = trim(q)
  return users
    |> scan()
    |> filter(|u| has_text(u.name, needle))
    |> sort_by(|u| u.email)
    |> map(profile)
}

# Whether `text` contains `part` (split gives more than one piece exactly when it does).
fn has_text(text: String, part: String) -> Bool {
  return len(split(text, part)) > 1
}

test "has_text" {
  assert(has_text("Grace Hopper", "ace"))
  assert(has_text("Ada", "Ada"))
  assert(!has_text("Grace", "grace"))
}
