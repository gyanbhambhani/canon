table users: User key email

type User {
  email: String,
  first_name: String,
  last_name: String,
  password_hash: String,
  id: String,
}

type Signup {
  email: String,
  first_name: String,
  last_name: String,
  password: String,
}

type Login {
  email: String,
  password: String,
}

type Profile {
  email: String,
  first_name: String,
  last_name: String,
}

type UserError =
  | Taken(email: String)
  | BadLogin

api fn signup(s: Signup) -> Result[Profile, UserError]
  route: POST "/users"
  effects: rand, store(users)
  requires: is_email(s.email) && trim(s.first_name) != "" && str_len(s.password) >= 8
{
  if is_some(get(users, s.email)) {
    return Err(Taken(s.email))
  }
  let user = User {
    email: s.email,
    first_name: trim(s.first_name),
    last_name: trim(s.last_name),
    password_hash: hash_password(s.password),
    id: uuid(),
  }
  insert(users, user)
  return Ok(profile(user))
}

fn profile(u: User) -> Profile {
  return Profile { email: u.email, first_name: u.first_name, last_name: u.last_name }
}

# The name shown for a user: first and last joined by a space, or the first alone.
fn display_name(u: User) -> String {
  return match u.last_name {
    "" => u.first_name,
    last => u.first_name + " " + last,
  }
}

api fn login(input: Login) -> Result[Profile, UserError]
  route: POST "/login"
  effects: store(users)
{
  return match get(users, input.email) {
    Some(u) => match verify_password(input.password, u.password_hash) {
      true => Ok(profile(u)),
      false => Err(BadLogin),
    },
    None => Err(BadLogin),
  }
}
