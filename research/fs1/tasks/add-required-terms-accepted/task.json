{
  "id": "add-required-terms-accepted",
  "kind": "change",
  "title": "Require terms_accepted (true) at signup",
  "features": [
    {
      "module": "frontend/src/features/signup.ts",
      "signature": "signup(baseUrl: string, email: string, name: string, password: string, termsAccepted: boolean): Promise<Outcome<Profile>>"
    }
  ],
  "supersedes": ["test_signup_and_login", "test_signup_validation", "test_reports", "signup-probe"],
  "validation": [
    {
      "feature": "signup",
      "args": [
        { "name": "email", "gen": "email" },
        { "name": "name", "gen": "name" },
        { "name": "password", "gen": "password" },
        { "name": "termsAccepted", "gen": "bool" }
      ],
      "request": {
        "method": "POST",
        "path": "/users",
        "body": { "email": "$email", "name": "$name", "password": "$password", "terms_accepted": "$termsAccepted" }
      }
    }
  ]
}
