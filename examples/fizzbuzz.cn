fn fizzbuzz(n: Int) -> String {
  if n % 15 == 0 {
    return "FizzBuzz"
  } else if n % 3 == 0 {
    return "Fizz"
  } else if n % 5 == 0 {
    return "Buzz"
  }
  return to_string(n)
}

fn main() -> Unit
  effects: io
{
  for n in range(1, 16) {
    print(fizzbuzz(n))
  }
}

test "multiples of three and five" {
  assert(fizzbuzz(15) == "FizzBuzz")
  assert(fizzbuzz(9) == "Fizz")
  assert(fizzbuzz(10) == "Buzz")
  assert(fizzbuzz(7) == "7")
}
