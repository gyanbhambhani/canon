{
  "name": "canon-lang",
  "version": "0.3.0",
  "description": "The programming language for AI agents. Typed, compiled, fits in a prompt. Every error ships with its fix.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://canon-lake.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyanbhambhani/canon.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/gyanbhambhani/canon/issues"
  },
  "keywords": [
    "programming-language",
    "ai-agents",
    "compiler",
    "llm",
    "typescript",
    "developer-tools"
  ],
  "bin": {
    "canon": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/standalone.ts --bundle --platform=node --format=iife --global-name=__canonRuntime --target=node20 --conditions=source --outfile=dist/runtime-standalone.js && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --conditions=source --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@canon/compiler": "workspace:*",
    "@canon/runtime": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
